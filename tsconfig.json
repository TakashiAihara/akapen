{
  "$schema": "https://json.schemastore.org/tsconfig",

  // bun first, strictest last. The array is last-wins, so strictest tightens the three
  // @tsconfig/bun relaxes: noUnusedLocals, noUnusedParameters and
  // noPropertyAccessFromIndexSignature.
  "extends": ["@tsconfig/bun/tsconfig.json", "@tsconfig/strictest/tsconfig.json"],

  "compilerOptions": {
    // strictest carries no module settings, so nothing needs restoring here.
    // Only spell out what the bases lack, or what there is a reason to turn off.
    "types": ["bun"],

    // web/ is built for the browser and needs the DOM types. Both sets are loaded;
    // the server never touches the DOM, but splitting the config buys too little.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // Build output (web/dist) is only embedded via `with { type: 'file' }`.
    // Resolving the real files instead fails with "no default export".
    "allowJs": false
  },

  "include": ["src", "scripts", "tests", "types", "shared", "web"]
}
